---
import '../styles/global.css';
import { content, langs, pathFor, type Lang } from '../data/cv';
import { withBase } from '../lib/url';
// Syne 600/800 + Geist 400/500 self-host (Fontsource, latin + latin-ext). ?url = cesta s hashem i s BASE_PATH
import syne600 from '@fontsource/syne/files/syne-latin-600-normal.woff2?url';
import syne600Ext from '@fontsource/syne/files/syne-latin-ext-600-normal.woff2?url';
import syne800 from '@fontsource/syne/files/syne-latin-800-normal.woff2?url';
import syne800Ext from '@fontsource/syne/files/syne-latin-ext-800-normal.woff2?url';
import geist400 from '@fontsource/geist/files/geist-latin-400-normal.woff2?url';
import geist400Ext from '@fontsource/geist/files/geist-latin-ext-400-normal.woff2?url';
import geist500 from '@fontsource/geist/files/geist-latin-500-normal.woff2?url';
import geist500Ext from '@fontsource/geist/files/geist-latin-ext-500-normal.woff2?url';
interface Props { lang: Lang; title: string; description: string }
const { lang, title, description } = Astro.props;
const { person } = content[lang];
const abs = (path: string) => new URL(withBase(path), Astro.site).href;
// og:image musí být absolutní URL (site + base)
const ogImage = abs(person.avatar);

const LATIN = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const LATIN_EXT = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF';
const face = (family: string, weight: number, src: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${src}) format('woff2');unicode-range:${range}}`;
const fontFaces = [
  face('Syne', 600, syne600Ext, LATIN_EXT), face('Syne', 600, syne600, LATIN),
  face('Syne', 800, syne800Ext, LATIN_EXT), face('Syne', 800, syne800, LATIN),
  face('Geist', 400, geist400Ext, LATIN_EXT), face('Geist', 400, geist400, LATIN),
  face('Geist', 500, geist500Ext, LATIN_EXT), face('Geist', 500, geist500, LATIN),
].join('\n');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(pathFor(lang))} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(pathFor(l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(pathFor('en'))} />
    <meta property="og:url" content={abs(pathFor(lang))} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'cs_CZ'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:image:alt" content={person.name} />
    <link rel="icon" type="image/jpeg" href={withBase('RountmanLogo.jpg')} />
    <link rel="apple-touch-icon" href={withBase('RountmanLogo.jpg')} />
    <!-- jméno v heru (LCP) -->
    <link rel="preload" href={syne800} as="font" type="font/woff2" crossorigin />
    <style is:global set:html={fontFaces}></style>
    <!-- skrýt intro prvky ještě před prvním vykreslením (jen pokud se bude animovat) -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { initMotion } from '../scripts/motion';
      import { initCore } from '../scripts/core';
      import { initChrome, initLangSwitch, restoreHash } from '../scripts/chrome';
      initChrome();
      initLangSwitch();
      initMotion();
      initCore();
      restoreHash();
    </script>
  </body>
</html>
