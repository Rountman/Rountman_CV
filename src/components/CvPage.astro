---
import Base from '../layouts/Base.astro';
import { content, pathFor, type Lang } from '../data/cv';
import { withBase } from '../lib/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'en' ? 'cs' : 'en';
const { person, about, career, projects, skills, studies, ui } = content[lang];

const [first, last] = person.name.split(' ');
const years = career.map((j) => j.year);
const span = `${Math.min(...years)}–${new Date().getFullYear()}`;
---
<Base
  lang={lang}
  title={`${person.name} – ${person.role}`}
  description={person.intro}
>
  <nav class="nav" aria-label={ui.navLabel}>
    <a href="#top">{person.title} {person.name}</a>
    <ul>
      <li><a href="#work">{ui.nav.work}</a></li>
      <li><a href="#projects">{ui.nav.projects}</a></li>
      <li><a href="#contact">{ui.nav.contact}</a></li>
      <li><a href={withBase(pathFor(other))} hreflang={other} lang={other} aria-label={ui.switchLabel}>{ui.switchTo}</a></li>
    </ul>
  </nav>

  <main id="top">
    <!-- HERO: jediný orchestrovaný moment při načtení -->
    <section class="hero wrap-pad" data-hero-zoom>
      <div class="hero-name">
        <div>
          <h1 data-intro data-zoom-name>{first} <span class="l2">{last}</span></h1>
          <div class="dim-ticks" data-zoom-fade>
            <p class="dim" data-intro-fade><span>{ui.inProduction(span)}</span></p>
          </div>
        </div>
      </div>
      <div class="hero-foot" data-zoom-fade>
        <p data-intro-rise>{person.intro}</p>
        <p class="meta" data-intro-rise>
          {person.role}<br />{person.location}
        </p>
      </div>
    </section>

    <!-- ABOUT: slova se rozsvěcují podle scrollu -->
    <section class="about block wrap" aria-labelledby="about-h">
      <h2 id="about-h" class="visually-hidden">{ui.about}</h2>
      <p data-scrub-words>{about}</p>
    </section>

    <!-- CAREER: hlavní scroll moment, horizontální pás + letopočet -->
    <section id="work" class="career" data-horizontal aria-labelledby="work-h">
      <div class="career-inner">
        <div class="career-side">
          <div class="wrap head">
            <h2 id="work-h">{ui.nav.work}</h2>
            <p>{ui.workLead}</p>
          </div>
          <div class="career-meter" aria-hidden="true">
            <span class="year" data-year-counter>{career[0].year}</span>
            <div class="progress"><i data-progress></i></div>
          </div>
        </div>
        <div class="career-window">
          <ol class="h-track" role="list">
            {career.map((job) => (
              <li class="job" data-year={job.year}>
                <span class="when">{job.from} – {job.to}</span>
                <h3>{job.role}</h3>
                <span class="co">{job.company}</span>
                <p class="desc">{job.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- PROJECTS: scény z hloubky (bez JS / reduced motion = seznam pod sebou) -->
    <section id="projects" class="projects wrap-pad" data-depth-scenes aria-labelledby="proj-h">
      <div class="head">
        <h2 id="proj-h">{ui.nav.projects}</h2>
        <p>{ui.projectsLead}</p>
      </div>
      <ol class="scenes" role="list">
        {projects.map((p, i) => (
          <li class="scene">
            <span class="pos">{ui.pos} {String(i + 1).padStart(2, '0')}</span>
            <span class="label">{ui.part}</span>
            <h3 class="part">{p.name}</h3>
            <p class="desc">{p.text}</p>
            <dl class="built">
              <dt>{ui.builtWith}</dt>
              <dd>{p.stack.join(', ')}</dd>
            </dl>
            {p.url && (
              <a class="src" href={p.url} target="_blank" rel="noopener">{ui.source}<span class="visually-hidden">: {p.name}</span></a>
            )}
          </li>
        ))}
      </ol>
      <span class="scene-count" data-scene-counter aria-hidden="true">01 / {String(projects.length).padStart(2, '0')}</span>
    </section>

    <!-- TOOLS: sestavení z hloubky (bez JS / reduced motion = statická mřížka skupin) -->
    <section class="tools wrap-pad" data-assemble aria-labelledby="skills-h">
      <div class="tools-head">
        <h2 id="skills-h">{ui.tools}</h2>
        <p>{ui.toolsLead}</p>
      </div>
      <div class="tool-groups">
        {skills.map((g) => (
          <div class="tool-group" data-assemble-group>
            <h3>{g.group}</h3>
            <span class="rule" data-assemble-rule aria-hidden="true"></span>
            <ul role="list">
              {g.items.map((s) => <li data-assemble-item>{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- STUDIES -->
    <section class="block wrap" aria-labelledby="edu-h">
      <div class="head">
        <h2 id="edu-h">{ui.studies}</h2>
        <p>{ui.studiesLead}</p>
      </div>
      <ul class="studies">
        {studies.map((s) => (
          <li>
            <span class="when">{s.when}</span>
            <span class="school">{s.school}</span>
            <span>{s.what}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="contact wrap" aria-labelledby="contact-h">
      <h2 id="contact-h" class="lead">{ui.contactLead}</h2>
      <a class="mail" href={`mailto:${person.email}`}>{person.email}</a>
      <div class="links">
        <a href={person.github} target="_blank" rel="noopener">GitHub</a>
        <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={withBase(person.cv)} download>{ui.downloadCv}</a>
      </div>
      <footer>
        <span>© {new Date().getFullYear()} {person.name}</span>
        <a href="#top">{ui.backToTop}</a>
      </footer>
    </section>
  </main>
</Base>
