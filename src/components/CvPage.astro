---
import Base from '../layouts/Base.astro';
import { content, pathFor, type Lang } from '../data/cv';
import { withBase } from '../lib/url';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'en' ? 'cs' : 'en';
const { person, about, career, projects, skills, studies, ui } = content[lang];

const [first, last] = person.name.split(' ');
const initials = person.name.split(' ').map((w) => w[0]).join('');

// Kotvy 3D objektu (storyboard v BRIEF.md): x, y = podíl poloviny okna, s = scale, o = opacity,
// m = volitelné okno morphu tvaru na cestě k této kotvě (viz scripts/core/anchors.ts)
type Pose = { x?: number; y?: number; s?: number; o?: number };
const core = (x: number, y: number, s: number, o: number, shape = 'sphere', m?: [number, number], mobile?: Pose) =>
  JSON.stringify({ x, y, s, o, shape, ...(m && { m }), ...(mobile && { mobile }) });
// mobil ve Work: text dole, objekt menší nahoře (nad nadpisem)
const workMobile: Pose = { x: 0, y: 0.55, s: 0.55, o: 0.8 };
// mobil v Tools a Studies jako dřív (y 0.3 + 0.25, s 0.35 × 0.7, o 0.25 × 0.6)
const toolsMobile: Pose = { x: 0, y: 0.55, s: 0.245, o: 0.15 };
const anchor = {
  hero: core(0, 0.12, 1.25, 1),
  about: core(0.55, 0, 0.75, 0.9),
  // Work: markery etap na 0, 115vh a 230vh sticky sekce (330vh). Čip dojede až se sticky
  work: [
    core(0.5, 0, 0.95, 1, 'chip', [0.75, 1], workMobile),
    core(0.5, 0, 1, 1, 'phone', undefined, workMobile),
    core(0.5, 0, 0.95, 1, 'browser', undefined, workMobile),
  ],
  projects: core(-0.68, -0.38, 0.45, 0.8),
  // Tools (pin +120 %): koule vpravo nahoře NAD mřížkou (y 0.5, s 0.3; při y 0.3 / s 0.35 ji na 1280×800
  // překrývala), drží celý pin a po pinu odjede lineárně se sekcí (y +2 za 100vh), ať jí mřížka neprojede.
  // Kotvy s `at` platí jen s pinem (mobil a reduced motion je vynechají). Studies vlastní kotvu nemá:
  // je kratší než okno, její kotva by vyšla před konec pinu; objekt se vrátí až za e-mail v Contact
  tools: JSON.stringify([
    { x: 0.7, y: 0.5, s: 0.3, o: 0.25, mobile: toolsMobile },
    { x: 0.7, y: 0.5, s: 0.3, o: 0.25, at: 120 },
    { x: 0.7, y: 2.5, s: 0.3, o: 0.25, at: 220, ease: 'linear' },
  ]),
  contact: core(0, 0.05, 1.5, 0.22),
};
// Work: role po etapách, v etapě od nejnovější
const stages = [0, 1, 2].map((st) => career.filter((j) => j.stage === st).reverse());
---
<Base
  lang={lang}
  title={`${person.name} – ${person.role}`}
  description={person.intro}
>
  <!-- skleněné jádro: fixed canvas za obsahem (scripts/core) -->
  <canvas class="core-canvas" data-core-canvas aria-hidden="true"></canvas>
  <div class="core-fallback" data-core-fallback aria-hidden="true"></div>

  <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>

  <nav class="nav" aria-label={ui.navLabel}>
    <a class="mark" href="#top"><span aria-hidden="true">{initials}</span><span class="visually-hidden">{person.name}</span></a>
    <ul>
      <li><a href="#work">{ui.nav.work}</a></li>
      <li><a href="#projects">{ui.nav.projects}</a></li>
      <li><a href="#contact">{ui.nav.contact}</a></li>
      <li><a href={withBase(pathFor(other))} hreflang={other} lang={other} aria-label={ui.switchLabel}>{ui.switchTo}</a></li>
    </ul>
  </nav>

  <main id="top">
    <!-- HERO: bez pinu. Jméno vlevo dole, intro vpravo; obojí vidět od prvního vykreslení (LCP).
         Jediný úvodní moment je objekt (scripts/core) -->
    <section class="hero" data-core={anchor.hero}>
      <div class="rings" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="hero-row">
        <h1>{first}<br />{last}</h1>
        <p class="intro">{person.intro}</p>
      </div>
      <div class="hint" data-scroll-hint aria-hidden="true"><i></i>{ui.scrollHint}</div>
    </section>

    <!-- ABOUT: velký text vlevo, objekt vpravo -->
    <section class="about" data-core={anchor.about} aria-labelledby="about-h">
      <h2 id="about-h" class="visually-hidden">{ui.about}</h2>
      <p>{about.lead} <span class="rest">{about.rest}</span></p>
    </section>

    <!-- WORK: hlavní moment. Sticky 100vh v sekci 330vh: vlevo nadpis + panel se 2 rolemi, vpravo objekt.
         Etapy (data-stages): čip → telefon → prohlížeč; bez JS = seznam všech rolí -->
    <section id="work" class="work" data-stages aria-labelledby="work-h">
      {anchor.work.map((k, i) => <div class="work-mark" style={`--at:${i * 115}vh`} data-stage-mark data-core={k} aria-hidden="true"></div>)}
      <div class="work-sticky">
        <div class="work-text">
          <h2 id="work-h">{ui.nav.work}</h2>
          <div class="panels">
            {stages.map((jobs) => (
              <article class="panel" data-stage-panel>
                {jobs.map((job) => (
                  <div class="role">
                    <span class="when">{job.from} – {job.to}</span>
                    <h3>{job.role}</h3>
                    <span class="co">{job.company}</span>
                    <p>{job.text}</p>
                  </div>
                ))}
              </article>
            ))}
          </div>
          <ol class="steps" aria-hidden="true">
            {stages.map(() => <li data-stage-step></li>)}
          </ol>
        </div>
      </div>
    </section>

    <!-- PROJECTS: nadpis vlevo, klidný seznam vpravo -->
    <section id="projects" class="projects wrap-pad" data-core={anchor.projects} aria-labelledby="proj-h">
      <h2 id="proj-h">{ui.nav.projects}</h2>
      <ol class="project-list" role="list">
        {projects.map((p) => (
          <li>
            {p.url
              ? <a class="name" href={p.url} target="_blank" rel="noopener">{p.name}</a>
              : <span class="name">{p.name}</span>}
            <span class="stack">{p.stack.join(', ')}</span>
            <p class="desc">{p.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- TOOLS: sestavení z hloubky (bez JS / reduced motion = statická mřížka skupin) -->
    <section class="tools wrap-pad" data-assemble data-core={anchor.tools} aria-labelledby="skills-h">
      <div class="tools-head">
        <h2 id="skills-h">{ui.tools}</h2>
        <p>{ui.toolsLead}</p>
      </div>
      <div class="tool-groups">
        {skills.map((g) => (
          <div class="tool-group" data-assemble-group>
            <h3>{g.group}</h3>
            <span class="rule" data-assemble-rule aria-hidden="true"></span>
            <ul role="list">
              {g.items.map((s) => <li data-assemble-item>{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- STUDIES -->
    <section class="block wrap" aria-labelledby="edu-h">
      <div class="head">
        <h2 id="edu-h">{ui.studies}</h2>
        <p>{ui.studiesLead}</p>
      </div>
      <ul class="studies">
        {studies.map((s) => (
          <li>
            <span class="when">{s.when}</span>
            <span class="school">{s.school}</span>
            <span>{s.what}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- CONTACT: min. 100svh, e-mail na 1 řádek přes celou šířku, objekt ztlumený za textem -->
    <section id="contact" class="contact wrap" data-core={anchor.contact} aria-labelledby="contact-h">
      <div class="contact-body">
        <h2 id="contact-h" class="lead">{ui.contactLead}</h2>
        <a class="mail" href={`mailto:${person.email}`}>{person.email.split('@')[0]}<wbr />@{person.email.split('@')[1]}</a>
        <div class="links">
          <a href={person.github} target="_blank" rel="noopener">GitHub</a>
          <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={withBase(person.cv)} download>{ui.downloadCv}</a>
        </div>
      </div>
      <footer>
        <span>© {new Date().getFullYear()} {person.name}</span>
        <a href="#top">{ui.backToTop}</a>
      </footer>
    </section>
  </main>
</Base>
